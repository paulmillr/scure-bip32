{
  "name": "@scure/bip32",
  "version": "2.4.0",
  "description": "Secure, audited & minimal implementation of BIP32 hierarchical deterministic (HD) wallets over secp256k1",
  "files": [
    "index.js",
    "index.d.ts",
    "index.ts"
  ],
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.7.1",
    "bismar": "0.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "scripts": {
    "benchmark:size": "bismar -bsm",
    "build": "tsc",
    "check": "jsbt-check",
